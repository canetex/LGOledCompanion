<Window x:Class="LGOledCompanion.SlideshowWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LGOledCompanion"
        WindowStartupLocation="Manual"
        WindowState="Normal"
        WindowStyle="None"
        ResizeMode="NoResize"
        Topmost="True"
        Background="Black"
        ShowInTaskbar="False"
        Cursor="None"
        Focusable="False">
    <Grid>
        <Image x:Name="Photo" Stretch="Uniform" />
        <Rectangle x:Name="Overlay" Fill="Black" IsHitTestVisible="False" Opacity="0" />
    </Grid>
</Window>
