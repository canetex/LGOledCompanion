<Window x:Class="LGOledCompanion.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LGOledCompanion"
        Width="520"
        Height="520"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">
    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="180" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Grid.Column="0" Margin="0,6" VerticalAlignment="Center" Text="Idle (minutos)" />
        <TextBox x:Name="IdleMinutes" Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,6" />

        <TextBlock Grid.Row="1" Grid.Column="0" Margin="0,6" VerticalAlignment="Center" Text="Transição (segundos)" />
        <TextBox x:Name="TransitionSeconds" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,6" />

        <TextBlock Grid.Row="2" Grid.Column="0" Margin="0,6" VerticalAlignment="Center" Text="Overlay (0-90%)" />
        <Slider x:Name="OverlaySlider" Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Minimum="0" Maximum="90" TickFrequency="10" IsSnapToTickEnabled="True" Margin="0,6" />

        <TextBlock Grid.Row="3" Grid.Column="0" Margin="0,6" VerticalAlignment="Center" Text="Pasta de fotos" />
        <TextBox x:Name="PhotoFolder" Grid.Row="3" Grid.Column="1" Margin="0,6,8,6" />
        <Button Grid.Row="3" Grid.Column="2" Content="..." Width="36" Click="BrowseFolder_Click" />

        <TextBlock Grid.Row="4" Grid.Column="0" Margin="0,6" VerticalAlignment="Center" Text="Noite início" />
        <TextBox x:Name="NightStart" Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,6" />

        <TextBlock Grid.Row="5" Grid.Column="0" Margin="0,6" VerticalAlignment="Center" Text="Noite fim" />
        <TextBox x:Name="NightEnd" Grid.Row="5" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,6" />

        <TextBlock Grid.Row="6" Grid.Column="0" Margin="0,6" VerticalAlignment="Center" Text="Device WebOS" />
        <TextBox x:Name="WebOsDevice" Grid.Row="6" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,6" />

        <TextBlock Grid.Row="7" Grid.Column="0" Margin="0,6" VerticalAlignment="Center" Text="LGTVcli.exe" />
        <TextBox x:Name="CliPath" Grid.Row="7" Grid.Column="1" Margin="0,6,8,6" />
        <Button Grid.Row="7" Grid.Column="2" Content="..." Width="36" Click="BrowseCli_Click" />

        <CheckBox x:Name="DebugMode" Grid.Row="8" Grid.Column="1" Grid.ColumnSpan="2" Content="Modo debug (log em disco)" Margin="0,10,0,6" />
        <CheckBox x:Name="Autostart" Grid.Row="9" Grid.Column="1" Grid.ColumnSpan="2" Content="Iniciar com o Windows" Margin="0,6" />

        <Button Grid.Row="10" Grid.Column="1" Grid.ColumnSpan="2" Content="Salvar" Width="120" HorizontalAlignment="Right" Margin="0,16,0,0" Click="Save_Click" />
    </Grid>
</Window>
