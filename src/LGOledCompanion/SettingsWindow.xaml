<Window x:Class="LGOledCompanion.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LGOledCompanion - Configurações"
        Height="700"
        Width="900"
        MinHeight="600"
        MinWidth="800"
        Background="#181818"
        Foreground="#FFFFFF"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI"
        Closed="Window_Closed">

    <Window.Resources>
        <SolidColorBrush x:Key="AccentBrush" Color="#FF3B7C"/>

        <Style TargetType="Border" x:Key="CardStyle">
            <Setter Property="Background" Value="#252526"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="Margin" Value="0,0,0,15"/>
        </Style>

        <Style TargetType="TextBlock" x:Key="CardTitle">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#E0E0E0"/>
            <Setter Property="Margin" Value="0,0,0,15"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#333333"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="5"/>
            <Setter Property="CaretBrush" Value="White"/>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="DarkComboItem" TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="ItemBd" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemBd" Property="Background" Value="#3A3A3A"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBd" Property="Background" Value="{DynamicResource AccentBrush}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DarkCombo" TargetType="ComboBox">
            <Setter Property="Background" Value="#333333"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="MinHeight" Value="28"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto"/>
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="ItemContainerStyle" Value="{StaticResource DarkComboItem}"/>
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton"
                                          Focusable="False"
                                          ClickMode="Press"
                                          HorizontalAlignment="Stretch"
                                          VerticalAlignment="Stretch"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="#333333" CornerRadius="4">
                                            <Path Data="M 0 0 L 4 4 L 8 0 Z"
                                                  Fill="White"
                                                  HorizontalAlignment="Right"
                                                  VerticalAlignment="Center"
                                                  Margin="0,0,8,0"/>
                                        </Border>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter x:Name="ContentSite"
                                              IsHitTestVisible="False"
                                              Margin="8,4,28,4"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Left"
                                              RecognizesAccessKey="True"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"/>
                            <TextBox x:Name="PART_EditableTextBox"
                                     Visibility="Collapsed"
                                     Background="Transparent"
                                     Foreground="White"
                                     CaretBrush="White"
                                     BorderThickness="0"
                                     Margin="8,4,28,4"
                                     VerticalAlignment="Center"
                                     VerticalContentAlignment="Center"
                                     Focusable="True"/>
                            <Popup x:Name="Popup"
                                   Placement="Bottom"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   PopupAnimation="Slide">
                                <Border Background="#2A2A2A"
                                        BorderBrush="#555555"
                                        BorderThickness="1"
                                        CornerRadius="4"
                                        MinWidth="{TemplateBinding ActualWidth}"
                                        MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                        Padding="0,4">
                                    <ScrollViewer>
                                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEditable" Value="True">
                                <Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="ContentSite" Property="Visibility" Value="Hidden"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FooterButton" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="15,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <Grid>
                                <Border x:Name="HoverWash" Background="#33FFFFFF" CornerRadius="4" Visibility="Collapsed"/>
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="HoverWash" Property="Visibility" Value="Visible"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="HoverWash" Property="Background" Value="#22000000"/>
                                <Setter TargetName="HoverWash" Property="Visibility" Value="Visible"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#88FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SliderRepeat" TargetType="RepeatButton">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Background="{TemplateBinding Background}" Height="4" CornerRadius="2" VerticalAlignment="Center"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Slider">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Minimum" Value="0"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid>
                            <Border Height="4" Background="#333333" CornerRadius="2" VerticalAlignment="Center"/>
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge" Style="{StaticResource SliderRepeat}" Background="{DynamicResource AccentBrush}"/>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge" Style="{StaticResource SliderRepeat}" Background="#333333"/>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Width="16" Height="16">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Ellipse Width="16" Height="16" Fill="{DynamicResource AccentBrush}"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="NavRadio" TargetType="RadioButton">
            <Setter Property="Foreground" Value="#E0E0E0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}"
                                BorderThickness="3,0,0,0"
                                BorderBrush="Transparent">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#2A2A2A"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#333333"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="#1E1E1E" BorderBrush="#333333" BorderThickness="0,0,1,0">
            <StackPanel Margin="10,20,10,10">
                <TextBlock x:Name="BrandTitle" Text="OLED Companion" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" Margin="10,0,0,30"/>

                <RadioButton x:Name="NavGeral" Content="⚙️ Geral" GroupName="SettingsNav" IsChecked="True" Style="{StaticResource NavRadio}" Margin="0,5" Checked="Nav_Checked"/>
                <RadioButton x:Name="NavVisual" Content="🖼️ Visual e Tempos" GroupName="SettingsNav" Style="{StaticResource NavRadio}" Margin="0,5" Checked="Nav_Checked"/>
                <RadioButton x:Name="NavTv" Content="📺 TV e CLI" GroupName="SettingsNav" Style="{StaticResource NavRadio}" Margin="0,5" Checked="Nav_Checked"/>
            </StackPanel>
        </Border>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="30,30,30,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Border Grid.Row="0" Background="#111111" CornerRadius="8" Height="150" Margin="0,0,0,16" BorderBrush="#333333" BorderThickness="1" ClipToBounds="True">
                    <Grid>
                        <TextBlock x:Name="PreviewPlaceholder" Text="📷 FOTO DE EXEMPLO" Foreground="#333" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <Image x:Name="PreviewPhoto" Stretch="Uniform"/>
                        <Rectangle x:Name="PreviewOverlay" IsHitTestVisible="False"/>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" HorizontalAlignment="Left" Margin="10">
                            <Button Content="Anterior" Style="{StaticResource FooterButton}" Background="#88000000" Padding="8,4" Click="PreviewPrevious_Click"/>
                            <Button Content="Próxima" Style="{StaticResource FooterButton}" Background="#88000000" Padding="8,4" Margin="6,0,0,0" Click="PreviewNext_Click"/>
                        </StackPanel>
                        <StackPanel VerticalAlignment="Bottom" HorizontalAlignment="Right" Margin="10">
                            <TextBlock x:Name="PreviewCaption" Text="Pré-visualização ao vivo" Foreground="#AAAAAA" FontSize="11" Background="#88000000" Padding="5,2"/>
                        </StackPanel>
                    </Grid>
                </Border>
                <ScrollViewer x:Name="ContentScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel>

                    <StackPanel x:Name="GeralPanel">
                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <TextBlock Text="Configurações Gerais" Style="{StaticResource CardTitle}"/>

                                <Grid Margin="0,0,0,10">
                                    <TextBlock Text="Tempo de inatividade (minutos):" VerticalAlignment="Center"/>
                                    <TextBox x:Name="IdleMinutes" Width="60" HorizontalAlignment="Right" TextAlignment="Center"/>
                                </Grid>

                                <Grid Margin="0,0,0,10">
                                    <TextBlock Text="Iniciar com o Windows:" VerticalAlignment="Center"/>
                                    <CheckBox x:Name="Autostart" HorizontalAlignment="Right"/>
                                </Grid>

                                <Grid Margin="0,0,0,10">
                                    <TextBlock Text="Modo debug (log em disco):" VerticalAlignment="Center"/>
                                    <CheckBox x:Name="DebugMode" HorizontalAlignment="Right"/>
                                </Grid>

                                <Grid>
                                    <TextBlock Text="Cor de destaque do App (Sliders):" VerticalAlignment="Center"/>
                                    <ComboBox x:Name="AccentCombo" Style="{StaticResource DarkCombo}" Width="160" HorizontalAlignment="Right" SelectionChanged="AccentCombo_SelectionChanged">
                                        <ComboBoxItem Content="Magenta (Padrão)"/>
                                        <ComboBoxItem Content="Azul Cyan"/>
                                        <ComboBoxItem Content="Verde Limão"/>
                                        <ComboBoxItem Content="Laranja"/>
                                    </ComboBox>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <TextBlock Text="Modo Noturno (Apenas tela preta/ScreenOff)" Style="{StaticResource CardTitle}"/>
                                <Grid Margin="0,0,0,10">
                                    <TextBlock Text="Início da noite:" VerticalAlignment="Center"/>
                                    <TextBox x:Name="NightStart" Width="80" HorizontalAlignment="Right" TextAlignment="Center"/>
                                </Grid>
                                <Grid>
                                    <TextBlock Text="Fim da noite:" VerticalAlignment="Center"/>
                                    <TextBox x:Name="NightEnd" Width="80" HorizontalAlignment="Right" TextAlignment="Center"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <Grid x:Name="VisualPanel" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Style="{StaticResource CardStyle}" Margin="0,0,8,0" VerticalAlignment="Stretch">
                            <StackPanel>
                                <TextBlock Text="Tempos do ciclo" Style="{StaticResource CardTitle}"/>
                                <TextBlock x:Name="FadeOutLabel" Text="Fade-out overlay" Margin="0,0,0,4"/>
                                <Slider x:Name="FadeOutSlider" Minimum="0" Maximum="120" TickFrequency="1" IsSnapToTickEnabled="True" Margin="0,0,0,8" ValueChanged="CycleSlider_ValueChanged"/>
                                <TextBlock x:Name="FadeInLabel" Text="Fade-in overlay" Margin="0,0,0,4"/>
                                <Slider x:Name="FadeInSlider" Minimum="0" Maximum="120" TickFrequency="1" IsSnapToTickEnabled="True" Margin="0,0,0,8" ValueChanged="CycleSlider_ValueChanged"/>
                                <TextBlock x:Name="HoldLabel" Text="Transição imagem" Margin="0,0,0,4"/>
                                <Slider x:Name="HoldSlider" Minimum="0" Maximum="120" TickFrequency="1" IsSnapToTickEnabled="True" Margin="0,0,0,6" ValueChanged="CycleSlider_ValueChanged"/>
                                <TextBlock x:Name="CycleTotalLabel" Foreground="#AAAAAA" FontSize="12" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="1" Style="{StaticResource CardStyle}" Margin="8,0,0,0" VerticalAlignment="Stretch">
                            <StackPanel>
                                <TextBlock Text="Overlay e fotos" Style="{StaticResource CardTitle}"/>
                                <TextBlock Text="Overlay (0-90%)" Margin="0,0,0,4"/>
                                <Slider x:Name="OverlaySlider" Minimum="0" Maximum="90" TickFrequency="10" IsSnapToTickEnabled="True" Margin="0,0,0,8" ValueChanged="OverlaySlider_ValueChanged"/>
                                <Grid Margin="0,0,0,10">
                                    <TextBlock Text="Cor do overlay:" VerticalAlignment="Center"/>
                                    <Button x:Name="OverlayColorButton" Height="28" Width="120" HorizontalAlignment="Right" BorderThickness="0" Click="PickOverlayColor_Click"/>
                                </Grid>
                                <TextBlock Text="Pasta de fotos:" Margin="0,0,0,6"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="PhotoFolder" Grid.Column="0" LostFocus="PhotoFolder_LostFocus" Margin="0,0,5,0"/>
                                    <Button Grid.Column="1" Content="..." Width="30" Background="#444" Foreground="White" BorderThickness="0" Click="BrowseFolder_Click"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <StackPanel x:Name="TvPanel" Visibility="Collapsed">
                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <TextBlock Text="Integração LGTVCompanion" Style="{StaticResource CardTitle}"/>
                                <Grid Margin="0,0,0,15">
                                    <TextBlock Text="Dispositivo WebOS:" VerticalAlignment="Center"/>
                                    <ComboBox x:Name="WebOsDevice" Style="{StaticResource DarkCombo}" IsEditable="True" Width="180" HorizontalAlignment="Right">
                                        <ComboBoxItem Content="Device1"/>
                                        <ComboBoxItem Content="TV_Sala"/>
                                        <ComboBoxItem Content="TV_Quarto"/>
                                    </ComboBox>
                                </Grid>
                                <Grid>
                                    <TextBlock Text="Caminho do LGTVcli.exe:" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <TextBox x:Name="CliPath" Width="250" Margin="0,0,5,0"/>
                                        <Button Content="..." Width="30" Background="#444" Foreground="White" BorderThickness="0" Click="BrowseCli_Click"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <Border Grid.Row="1" Background="#1E1E1E" BorderBrush="#333333" BorderThickness="0,1,0,0" Padding="20,15">
                <Grid>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                        <Button Content="📺 Testar TV" Style="{StaticResource FooterButton}" Background="#333333" Click="TestTv_Click"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Cancelar" Style="{StaticResource FooterButton}" Background="Transparent" Margin="0,0,10,0" Click="Cancel_Click"/>
                        <Button x:Name="SaveButton" Content="Salvar Configurações" Style="{StaticResource FooterButton}" Background="{DynamicResource AccentBrush}" Padding="25,8" FontWeight="Bold" Click="Save_Click"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
